Cell[BoxData[
 StyleBox[
  TagBox[
   TagBox[GridBox[{
      {
       TagBox["\<\"Distribuci\[OAcute]n\"\>",
        HoldForm], 
       TagBox["\<\"Ajuste\"\>",
        HoldForm], 
       TagBox["\<\"LogL\"\>",
        HoldForm], 
       TagBox["\<\"AIC\"\>",
        HoldForm]},
      {"\<\"Power law\"\>", 
       RowBox[{"ParetoDistribution", "[", 
        RowBox[{"1.`", ",", "0.5307855095269456`"}], "]"}], 
